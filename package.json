{
  "name": "saferaah-air",
  "version": "1.0.0",
  "description": "SafeRaah Air: an urban air-quality assistant for families in Delhi — clean-air routes, live AQI and the Gemini-powered Saans assistant",
  "scripts": {
    "data": "bash pipeline/fetch_delhi.sh",
    "data:fetch": "node scripts/fetch-data.mjs",
    "dev": "node scripts/fetch-data.mjs && vite",
    "build": "node scripts/fetch-data.mjs && vite build",
    "start": "tsx server/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json shared server web/src scripts pipeline tests",
    "test": "node scripts/fetch-data.mjs && vitest run",
    "test:coverage": "node scripts/fetch-data.mjs && vitest run --coverage",
    "test:e2e": "python3 -I tests/e2e/test_app.py",
    "check": "npm run typecheck && npm run lint && npm test",
    "cap:sync": "npm run build && cap sync"
  },
  "keywords": [],
  "author": "Yash Gupta",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "lucide": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "opening_hours": "^3.15.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.1",
    "geojson-vt": "^5.0.4",
    "oxlint": "^1.95.0",
    "playwright-core": "^1.65.0",
    "smp-noto-glyphs": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vt-pbf": "^3.1.3"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
